{
  "name": "nexo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <=3.1.3": "3.1.4",
      "glob@>=11.0.0 <11.1.0": "11.1.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "lodash@>=4.0.0 <=4.17.23": "4.18.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "sharp@<0.35.0": "0.35.0"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "pnpm db:generate && turbo run lint",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "test": "pnpm db:generate && turbo run test",
    "test:coverage": "pnpm db:generate && turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:reset": "node scripts/e2e-reset.mjs",
    "test:e2e:quality": "pnpm test:e2e:reset && node scripts/run-e2e-quality.mjs",
    "test:e2e:canonical": "node scripts/e2e-canonical-checkpoints.mjs",
    "test:e2e:freshness": "node scripts/e2e-runtime-freshness.mjs",
    "test:cash:cleanup": "bash scripts/cash-test-cleanup.sh",
    "cash:certify": "bash scripts/cash-certify.sh",
    "manual-acceptance:prepare": "pnpm manual-acceptance:setup",
    "manual-acceptance:setup": "bash scripts/manual-acceptance-env.sh setup",
    "manual-acceptance:start": "bash scripts/manual-acceptance-env.sh start",
    "manual-acceptance:status": "bash scripts/manual-acceptance-env.sh status",
    "manual-acceptance:logs": "bash scripts/manual-acceptance-env.sh logs",
    "manual-acceptance:stop": "bash scripts/manual-acceptance-env.sh stop",
    "manual-acceptance:restart": "bash scripts/manual-acceptance-env.sh restart",
    "manual-acceptance:rebuild": "bash scripts/manual-acceptance-env.sh rebuild",
    "manual-acceptance:reset": "bash scripts/manual-acceptance-env.sh reset",
    "manual-acceptance:record": "node scripts/manual-acceptance-record.mjs",
    "owner:onboarding:reset": "node scripts/owner-onboarding.mjs reset",
    "owner:onboarding:progress:reset": "node scripts/owner-onboarding.mjs progress",
    "owner:onboarding:new-user": "node scripts/owner-onboarding.mjs new-user",
    "owner:onboarding:new-organization": "node scripts/owner-onboarding.mjs new-organization",
    "owner:business:new": "node scripts/owner-onboarding.mjs new-business",
    "owner:alpha2:reset": "node scripts/owner-onboarding.mjs alpha2",
    "owner:share": "bash scripts/owner-share.sh",
    "owner:clean": "node scripts/owner-storage.mjs clean",
    "owner:artifacts:clean": "node scripts/owner-storage.mjs artifacts-clean",
    "owner:logs:clean": "node scripts/owner-storage.mjs logs-clean",
    "owner:cache:clean": "node scripts/owner-storage.mjs cache-clean",
    "owner:docker:clean": "node scripts/owner-storage.mjs docker-clean",
    "owner:disk:report": "node scripts/owner-storage.mjs report",
    "manual-acceptance:scenarios": "node scripts/generate-manual-acceptance.mjs",
    "sales-admin:certify": "bash scripts/sales-admin-certify.sh",
    "sales-admin:performance": "node tests/performance/sales-administration.mjs",
    "test:ui": "pnpm --filter @nexo/ui build-storybook && playwright test --config=playwright.ui.config.ts",
    "test:ui:update": "pnpm --filter @nexo/ui build-storybook && playwright test --config=playwright.ui.config.ts --update-snapshots",
    "flutter:tokens": "pnpm --filter @nexo/flutter-design tokens:check",
    "flutter:format": "cd packages/nexo_flutter_design && dart format --output=none --set-exit-if-changed .",
    "flutter:analyze": "cd packages/nexo_flutter_design && flutter analyze",
    "flutter:test": "cd packages/nexo_flutter_design && flutter test",
    "flutter:pos:format": "cd apps/nexo_pos && dart format --output=none --set-exit-if-changed lib test",
    "flutter:pos:analyze": "cd apps/nexo_pos && flutter analyze",
    "flutter:pos:test": "cd apps/nexo_pos && flutter test --concurrency=1",
    "flutter:pos:build": "cd apps/nexo_pos && flutter build web --dart-define=NEXO_TEST_HARNESS=true",
    "flutter:pos:check": "pnpm flutter:pos:format && pnpm flutter:pos:analyze && pnpm flutter:pos:test",
    "flutter:components": "pnpm --filter @nexo/flutter-design components:check",
    "flutter:check": "pnpm flutter:tokens && pnpm flutter:components && pnpm flutter:format && pnpm flutter:analyze && pnpm flutter:test && pnpm flutter:pos:check",
    "notifications:retry": "node scripts/notifications-retry.mjs --retry-pending",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @nexo/database generate",
    "db:migrate": "pnpm --filter @nexo/database migrate:dev",
    "db:deploy": "pnpm --filter @nexo/database migrate:deploy",
    "db:seed": "pnpm --filter @nexo/database seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.61.1",
    "@types/node": "24.1.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "turbo": "2.5.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md,css}": "prettier --write"
  }
}
