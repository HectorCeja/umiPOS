NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
DEV_LAN_HOST=
DEV_WEB_PORT=3000
DEV_API_PORT=3001
DEV_OBJECT_STORAGE_PORT=9000
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://nexo_runtime:nexo_runtime_local_only@localhost:5432/nexo?schema=public
MIGRATION_DATABASE_URL=postgresql://nexo_migration:nexo_migration_local_only@localhost:5432/nexo?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nexo_local
S3_SECRET_KEY=nexo_local_only
S3_BUCKET=nexo-local
S3_FORCE_PATH_STYLE=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@nexo.local
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
LOCAL_DEVELOPMENT=true
AUTH_TOKEN_HMAC_SECRET=nexo-local-token-hmac-secret-change-in-production
AUTH_RATE_LIMIT_HMAC_SECRET=nexo-local-rate-limit-hmac-secret-change-in-production
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_ACCESS_TTL_SECONDS=900
AUTH_IDLE_TTL_SECONDS=1800
AUTH_ABSOLUTE_TTL_SECONDS=43200
AUTH_REMEMBER_ABSOLUTE_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_DEVICE_RECOGNITION_TTL_SECONDS=2592000
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOCK_TTL_SECONDS=900
AUTH_PASSWORD_BLOCKLIST_FILE=./infra/identity/password-blocklist.txt
IDENTITY_DEFAULT_LOCALE=es-MX
IDENTITY_DEFAULT_TIME_ZONE=America/Mazatlan
IDENTITY_DEFAULT_REGIONAL_FORMAT=es-MX
IDENTITY_PASSWORD_MIN_LENGTH=15
IDENTITY_PASSWORD_MAX_LENGTH=128
IDENTITY_PASSWORD_ARGON2_MEMORY_KIB=19456
IDENTITY_PASSWORD_ARGON2_PASSES=2
IDENTITY_PASSWORD_ARGON2_PARALLELISM=1
IDENTITY_PASSWORD_HISTORY_DEPTH=0
IDENTITY_PASSWORD_EXPIRATION_DAYS=0
IDENTITY_FEATURE_OAUTH=false
IDENTITY_FEATURE_SSO=false
IDENTITY_FEATURE_PASSKEYS=false
IDENTITY_FEATURE_WEBAUTHN=false
IDENTITY_FEATURE_MAGIC_LINKS=false
IDENTITY_FEATURE_PASSWORDLESS=false
OTEL_SERVICE_NAME=nexo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_OBJECT_STORAGE_URL=http://localhost:9000
# Server-owned CSP origins. Never populate these from request/user input.
NEXO_PUBLIC_API_ORIGIN=http://localhost:3001
NEXO_PUBLIC_MEDIA_ORIGIN=
