{
  "version": "3.0.0",
  "operations": [
    "GET /health/live",
    "GET /health/ready",
    "POST /v1/auth/login",
    "POST /v1/auth/refresh",
    "POST /v1/auth/logout",
    "POST /v1/auth/logout-all",
    "POST /v1/auth/password-reset/request",
    "POST /v1/auth/password-reset/complete",
    "POST /v1/auth/email-verification/request",
    "POST /v1/auth/email-verification/complete",
    "GET /v1/identity",
    "GET /v1/sessions",
    "DELETE /v1/sessions/{sessionId}",
    "GET /v1/organizations/{organizationId}",
    "PATCH /v1/organizations/{organizationId}",
    "GET /v1/organizations/{organizationId}/branches",
    "POST /v1/organizations/{organizationId}/branches",
    "GET /v1/organizations/{organizationId}/memberships",
    "POST /v1/organizations/{organizationId}/memberships",
    "GET /v1/organizations/{organizationId}/authorization/context",
    "POST /v1/organizations/{organizationId}/authorization/evaluate",
    "GET /v1/organizations/{organizationId}/roles",
    "GET /v1/organizations/{organizationId}/permissions",
    "GET /v1/organizations/{organizationId}/feature-flags",
    "GET /v1/users/{userId}",
    "GET /v1/users/{userId}/identity",
    "GET /v1/users/{userId}/emails"
  ],
  "schemas": {
    "LoginRequest": ["email", "password", "deviceFingerprint", "deviceName"],
    "EmailRequest": ["email"],
    "PasswordResetCompleteRequest": ["token", "password"],
    "TokenRequest": ["token"],
    "AuthStatus": ["status"],
    "AcceptedStatus": ["status"],
    "AuthenticatedIdentity": [
      "sessionId",
      "userId",
      "email",
      "displayName",
      "emailVerified",
      "mfaStatus"
    ],
    "Session": [
      "id",
      "deviceId",
      "deviceName",
      "ipAddress",
      "userAgent",
      "location",
      "trustLevel",
      "createdAt",
      "lastActivityAt",
      "idleExpiresAt",
      "absoluteExpiresAt",
      "current"
    ],
    "Organization": [
      "id",
      "slug",
      "name",
      "status",
      "countryCode",
      "defaultLocale",
      "defaultCurrency",
      "timeZone",
      "branding",
      "settings",
      "version"
    ],
    "Branch": ["id", "tenantId", "code", "name", "status", "businessHours", "settings", "version"],
    "Membership": [
      "id",
      "tenantId",
      "principalId",
      "role",
      "roles",
      "accessScope",
      "branchIds",
      "status",
      "version"
    ],
    "AuthorizationContext": [
      "tenantContext",
      "organizationStatus",
      "selectedBranchId",
      "roles",
      "grants",
      "features",
      "evaluatedAt"
    ],
    "AuthorizationRole": ["key", "name", "description", "registryVersion", "effective"],
    "Permission": [
      "key",
      "resource",
      "action",
      "accessKind",
      "featureKey",
      "description",
      "registryVersion",
      "effective",
      "scopes"
    ],
    "FeatureFlag": ["key", "name", "enabled", "version"],
    "PermissionEvaluationRequest": ["permission", "resource"],
    "AuthorizationDecision": ["allowed", "permission", "registryVersion", "reason", "grantedBy"],
    "User": [
      "id",
      "status",
      "givenName",
      "familyName",
      "displayName",
      "avatarUrl",
      "locale",
      "timeZone",
      "regionalFormat",
      "createdAt",
      "updatedAt",
      "statusChangedAt",
      "lastAccessedAt",
      "deletedAt",
      "preferences",
      "metadata"
    ],
    "Identity": ["userId", "status", "features"],
    "EmailIdentity": [
      "id",
      "userId",
      "address",
      "status",
      "primary",
      "verifiedAt",
      "createdAt",
      "updatedAt"
    ],
    "Problem": ["type", "title", "status", "detail", "instance"]
  }
}
