{
  "name": "@nexo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "pnpm seed:prerequisites && pnpm seed:run",
    "seed:prerequisites": "pnpm --filter @nexo/authorization build && pnpm --filter @nexo/control-plane build",
    "seed:run": "tsx prisma/seed.ts",
    "typecheck": "prisma validate && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nexo/authorization": "workspace:*",
    "@nexo/control-plane": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@nexo/typescript-config": "workspace:*",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "17.2.1",
    "prisma": "7.8.0",
    "tsx": "4.20.3",
    "vitest": "3.2.4"
  }
}
