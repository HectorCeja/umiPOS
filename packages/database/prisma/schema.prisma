generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model PlatformMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_metadata")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDING
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MembershipRole {
  OWNER
  ADMIN
  SUPERVISOR
  CASHIER
  EMPLOYEE
  ACCOUNTANT
}

enum MembershipAccessScope {
  ALL_BRANCHES
  RESTRICTED
}

enum AuthorizationScope {
  GLOBAL
  ORGANIZATION
  BRANCH
  SELF
  CUSTOM
}

enum IdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
  DELETED
  EXPIRED
}

enum EmailIdentityStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum MfaStatus {
  NOT_ENROLLED
  ENROLLED
  REQUIRED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionTrustLevel {
  UNTRUSTED
  RECOGNIZED
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  REUSED
}

enum IdentityTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum OnboardingStatus {
  DRAFT
  COMPLETED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BusinessTemplateStatus {
  ACTIVE
  RETIRED
}

enum ProductType {
  PHYSICAL
  SERVICE
  BUNDLE
  KIT
  COMPOSITE
  DIGITAL
  GIFT_CARD
  SUBSCRIPTION
  CUSTOM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISABLED
}

enum BarcodeType {
  EAN
  UPC
  GTIN
  QR
  INTERNAL
}

enum ProductMediaStatus {
  PENDING
  ACTIVE
  DELETED
}

enum ProductPriceKind {
  BASE
  PRICE_LIST
  CUSTOMER
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RESERVATION_RELEASE
  WASTE
  CONSUMPTION
  RETURN
  CORRECTION
  COUNT
  IMPORT
}

enum InventoryStockState {
  ON_HAND
  RESERVED
  COMMITTED
  IN_TRANSIT
  DAMAGED
  QUARANTINE
}

enum InventoryLocationType {
  BRANCH
  WAREHOUSE
  ZONE
  SHELF
  BIN
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum InventoryCostMethod {
  FIFO
  WEIGHTED_AVERAGE
  STANDARD
  LIFO
}

enum InventoryTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Organization {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String                   @unique @db.VarChar(80)
  name               String                   @db.VarChar(160)
  status             OrganizationStatus       @default(ACTIVE)
  countryCode        String                   @map("country_code") @db.Char(2)
  defaultLocale      String                   @map("default_locale") @db.VarChar(35)
  defaultCurrency    String                   @map("default_currency") @db.Char(3)
  timeZone           String                   @map("time_zone") @db.VarChar(63)
  branding           Json                     @default("{}") @db.JsonB
  settings           Json                     @default("{}") @db.JsonB
  legalTaxId         String?                  @map("legal_tax_id") @db.VarChar(32)
  address            Json                     @default("{}") @db.JsonB
  dateFormat         String                   @default("DD/MM/YYYY") @map("date_format") @db.VarChar(32)
  timeFormat         String                   @default("24h") @map("time_format") @db.VarChar(8)
  moneyFormat        String                   @default("symbol-before") @map("money_format") @db.VarChar(32)
  regionalSettings   Json                     @default("{}") @map("regional_settings") @db.JsonB
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches           Branch[]
  memberships        Membership[]
  features           OrganizationFeature[]
  onboarding         OrganizationOnboarding?
  invitations        OrganizationInvitation[]
  controlPlaneEvents ControlPlaneEvent[]

  @@map("organizations")
}

model Branch {
  id               String                         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                         @map("tenant_id") @db.Uuid
  code             String                         @db.VarChar(50)
  name             String                         @db.VarChar(160)
  status           BranchStatus                   @default(ACTIVE)
  timeZone         String?                        @map("time_zone") @db.VarChar(63)
  locale           String?                        @db.VarChar(35)
  currency         String?                        @db.Char(3)
  businessHours    Json                           @default("{}") @map("business_hours") @db.JsonB
  settings         Json                           @default("{}") @db.JsonB
  version          Int                            @default(1)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scopes           MembershipBranchScope[]
  invitationScopes OrganizationInvitationBranch[]

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("branches")
}

model Membership {
  id                 String                        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                        @map("tenant_id") @db.Uuid
  principalId        String                        @map("principal_id") @db.Uuid
  role               MembershipRole
  accessScope        MembershipAccessScope         @default(ALL_BRANCHES) @map("access_scope")
  status             MembershipStatus              @default(ACTIVE)
  version            Int                           @default(1)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchScopes       MembershipBranchScope[]
  authorizationRoles MembershipAuthorizationRole[]

  @@id([tenantId, id])
  @@unique([tenantId, principalId])
  @@index([principalId, status])
  @@index([tenantId, role, status])
  @@map("memberships")
}

model MembershipBranchScope {
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  branchId     String     @map("branch_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch       Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, branchId])
  @@index([tenantId, branchId])
  @@map("membership_branch_scopes")
}

model AuthorizationRoleDefinition {
  key             String                        @id @db.VarChar(64)
  name            String                        @db.VarChar(100)
  description     String                        @db.VarChar(500)
  system          Boolean                       @default(true)
  registryVersion Int                           @map("registry_version")
  createdAt       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions     AuthorizationRolePermission[]
  assignments     MembershipAuthorizationRole[]

  @@map("authorization_role_definitions")
}

model AuthorizationPermissionDefinition {
  key             String                        @id @db.VarChar(100)
  resource        String                        @db.VarChar(80)
  action          String                        @db.VarChar(80)
  accessKind      String                        @map("access_kind") @db.VarChar(16)
  featureKey      String?                       @map("feature_key") @db.VarChar(64)
  description     String                        @db.VarChar(500)
  registryVersion Int                           @map("registry_version")
  createdAt       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles           AuthorizationRolePermission[]

  @@index([resource, action])
  @@map("authorization_permission_definitions")
}

model AuthorizationRolePermission {
  roleKey       String                            @map("role_key") @db.VarChar(64)
  permissionKey String                            @map("permission_key") @db.VarChar(100)
  scope         AuthorizationScope
  createdAt     DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  role          AuthorizationRoleDefinition       @relation(fields: [roleKey], references: [key], onDelete: Restrict)
  permission    AuthorizationPermissionDefinition @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleKey, permissionKey])
  @@index([permissionKey])
  @@map("authorization_role_permissions")
}

model MembershipAuthorizationRole {
  id           String                      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                      @map("tenant_id") @db.Uuid
  membershipId String                      @map("membership_id") @db.Uuid
  roleKey      String                      @map("role_key") @db.VarChar(64)
  scope        AuthorizationScope          @default(ORGANIZATION)
  branchId     String?                     @map("branch_id") @db.Uuid
  customScope  String?                     @map("custom_scope") @db.VarChar(160)
  validFrom    DateTime?                   @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?                   @map("valid_until") @db.Timestamptz(6)
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership   Membership                  @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         AuthorizationRoleDefinition @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, membershipId, roleKey])
  @@index([tenantId, membershipId])
  @@index([tenantId, branchId])
  @@map("membership_authorization_roles")
}

model AuthorizationFeatureDefinition {
  key             String                @id @db.VarChar(64)
  name            String                @db.VarChar(100)
  registryVersion Int                   @map("registry_version")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations   OrganizationFeature[]

  @@map("authorization_feature_definitions")
}

model BusinessTemplate {
  key                  String                   @id @db.VarChar(64)
  name                 String                   @db.VarChar(100)
  businessType         String                   @map("business_type") @db.VarChar(64)
  description          String                   @db.VarChar(500)
  status               BusinessTemplateStatus   @default(ACTIVE)
  version              Int
  features             Json                     @db.JsonB
  initialSettings      Json                     @map("initial_settings") @db.JsonB
  categorySuggestions  Json                     @map("category_suggestions") @db.JsonB
  suggestedPermissions Json                     @map("suggested_permissions") @db.JsonB
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  onboardings          OrganizationOnboarding[]

  @@index([businessType, status])
  @@map("business_templates")
}

model OrganizationOnboarding {
  tenantId        String            @id @map("tenant_id") @db.Uuid
  status          OnboardingStatus  @default(DRAFT)
  currentStep     Int               @default(1) @map("current_step")
  businessType    String?           @map("business_type") @db.VarChar(64)
  templateKey     String?           @map("template_key") @db.VarChar(64)
  templateVersion Int?              @map("template_version")
  answers         Json              @default("{}") @db.JsonB
  version         Int               @default(1)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template        BusinessTemplate? @relation(fields: [templateKey], references: [key], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("organization_onboarding")
}

model OrganizationInvitation {
  id               String                         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                         @map("tenant_id") @db.Uuid
  email            String                         @db.VarChar(320)
  normalizedEmail  String                         @map("normalized_email") @db.VarChar(320)
  tokenHash        String                         @unique @map("token_hash") @db.Char(64)
  roleKey          String                         @map("role_key") @db.VarChar(64)
  accessScope      MembershipAccessScope          @map("access_scope")
  status           InvitationStatus               @default(PENDING)
  expiresAt        DateTime                       @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?                      @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?                      @map("revoked_at") @db.Timestamptz(6)
  invitedByUserId  String                         @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?                        @map("accepted_by_user_id") @db.Uuid
  resendCount      Int                            @default(0) @map("resend_count")
  version          Int                            @default(1)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches         OrganizationInvitationBranch[]

  @@id([tenantId, id])
  @@index([tenantId, normalizedEmail, status])
  @@index([tenantId, expiresAt])
  @@map("organization_invitations")
}

model OrganizationInvitationBranch {
  tenantId     String                 @map("tenant_id") @db.Uuid
  invitationId String                 @map("invitation_id") @db.Uuid
  branchId     String                 @map("branch_id") @db.Uuid
  invitation   OrganizationInvitation @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Cascade)
  branch       Branch                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, invitationId, branchId])
  @@index([tenantId, branchId])
  @@map("organization_invitation_branches")
}

model ControlPlaneEvent {
  id           String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  actorUserId  String       @map("actor_user_id") @db.Uuid
  type         String       @db.VarChar(100)
  targetType   String       @map("target_type") @db.VarChar(64)
  targetId     String       @map("target_id") @db.VarChar(100)
  outcome      String       @db.VarChar(32)
  metadata     Json         @default("{}") @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@map("control_plane_events")
}

model OrganizationFeature {
  tenantId     String                         @map("tenant_id") @db.Uuid
  featureKey   String                         @map("feature_key") @db.VarChar(64)
  enabled      Boolean                        @default(false)
  config       Json                           @default("{}") @db.JsonB
  version      Int                            @default(1)
  createdAt    DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  feature      AuthorizationFeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Restrict)

  @@id([tenantId, featureKey])
  @@index([tenantId, enabled])
  @@map("organization_features")
}

model User {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String                      @unique @db.VarChar(320)
  normalizedEmail    String                      @unique @map("normalized_email") @db.VarChar(320)
  displayName        String                      @map("display_name") @db.VarChar(160)
  givenName          String                      @map("given_name") @db.VarChar(100)
  familyName         String                      @map("family_name") @db.VarChar(100)
  avatarUrl          String?                     @map("avatar_url") @db.VarChar(2048)
  avatarMedia        ProfileAvatarMediaRecord[]
  locale             String                      @db.VarChar(35)
  timeZone           String                      @map("time_zone") @db.VarChar(63)
  regionalFormat     String                      @map("regional_format") @db.VarChar(35)
  status             IdentityStatus              @default(PENDING_VERIFICATION)
  statusReason       String?                     @map("status_reason") @db.VarChar(500)
  statusChangedAt    DateTime                    @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  emailVerifiedAt    DateTime?                   @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt  DateTime?                   @map("password_changed_at") @db.Timestamptz(6)
  mfaStatus          MfaStatus                   @default(NOT_ENROLLED) @map("mfa_status")
  failedLoginCount   Int                         @default(0) @map("failed_login_count")
  firstFailedLoginAt DateTime?                   @map("first_failed_login_at") @db.Timestamptz(6)
  lockedUntil        DateTime?                   @map("locked_until") @db.Timestamptz(6)
  lastAccessedAt     DateTime?                   @map("last_accessed_at") @db.Timestamptz(6)
  deletedAt          DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  preferences        Json                        @default("{}") @db.JsonB
  metadata           Json                        @default("{}") @db.JsonB
  featureOverrides   Json                        @default("{}") @map("feature_overrides") @db.JsonB
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordCredential PasswordCredential?
  passwordHistory    PasswordCredentialHistory[]
  emailIdentities    UserEmail[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  devices            Device[]
  tokens             IdentityToken[]
  securityEvents     SecurityEvent[]

  @@index([status])
  @@map("users")
}

model ProfileAvatarMediaRecord {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  objectKey   String    @unique @map("object_key") @db.VarChar(500)
  contentType String    @map("content_type") @db.VarChar(80)
  sizeBytes   Int       @map("size_bytes")
  checksum    String    @db.Char(64)
  etag        String?   @db.VarChar(128)
  status      String    @default("ACTIVE") @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("profile_avatar_media")
}

model PasswordCredential {
  userId           String    @id @map("user_id") @db.Uuid
  hash             String    @db.VarChar(256)
  salt             String    @db.VarChar(64)
  algorithm        String    @default("argon2id-v1") @db.VarChar(32)
  memoryKiB        Int       @default(19456) @map("memory_kib")
  passes           Int       @default(2)
  parallelism      Int       @default(1)
  algorithmVersion Int       @default(1) @map("algorithm_version")
  mustChange       Boolean   @default(false) @map("must_change")
  changedAt        DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model PasswordCredentialHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  hash             String   @db.VarChar(256)
  salt             String   @db.VarChar(64)
  algorithm        String   @db.VarChar(32)
  algorithmVersion Int      @map("algorithm_version")
  memoryKiB        Int      @map("memory_kib")
  passes           Int
  parallelism      Int
  changedAt        DateTime @map("changed_at") @db.Timestamptz(6)
  retiredAt        DateTime @default(now()) @map("retired_at") @db.Timestamptz(6)
  reason           String   @db.VarChar(50)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, retiredAt])
  @@map("password_credential_history")
}

model UserEmail {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  address           String              @db.VarChar(320)
  normalizedAddress String              @unique @map("normalized_address") @db.VarChar(320)
  status            EmailIdentityStatus @default(PENDING)
  isPrimary         Boolean             @default(false) @map("is_primary")
  verifiedAt        DateTime?           @map("verified_at") @db.Timestamptz(6)
  revokedAt         DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens            IdentityToken[]

  @@index([userId, status])
  @@map("user_emails")
}

model Device {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  fingerprint  String    @db.VarChar(128)
  name         String    @db.VarChar(160)
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  trustedUntil DateTime? @map("trusted_until") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@unique([userId, fingerprint])
  @@index([userId, revokedAt])
  @@map("devices")
}

model Session {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  deviceId          String?           @map("device_id") @db.Uuid
  accessTokenHash   String            @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash  String            @unique @map("refresh_token_hash") @db.Char(64)
  csrfTokenHash     String            @map("csrf_token_hash") @db.Char(64)
  status            SessionStatus     @default(ACTIVE)
  fingerprintHash   String            @map("fingerprint_hash") @db.Char(64)
  location          String?           @db.VarChar(160)
  trustLevel        SessionTrustLevel @default(UNTRUSTED) @map("trust_level")
  ipAddress         String            @map("ip_address") @db.VarChar(64)
  userAgent         String            @map("user_agent") @db.VarChar(512)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
