{
  "name": "@nexo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "dev": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --no-open",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "next": ">=16 <17",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@nexo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/nextjs-vite": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "26.1.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.5.0",
    "vite": "7.0.6",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.6",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.2.8"
  }
}
